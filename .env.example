# Postgres connection string (Neon, Supabase, RDS, local — anything Postgres).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the staff panel at /admin.
ADMIN_PASSWORD=change-me

# Signs the staff session cookie. Use 32+ random bytes; rotating it logs everyone out.
SESSION_SECRET=run-openssl-rand-hex-32

# Public base URL, used for canonical links, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — Connect (seller payouts) + Billing (Verified $20/mo seller plan).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price id for the Verified seller plan ($20/month).
STRIPE_SELLER_PLAN_PRICE_ID=price_...

# Vercel Blob — listing photos, logos, banners (Dashboard → Storage → Blob).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
